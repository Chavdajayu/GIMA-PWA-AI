# ==========================================
# GIMA AI Studio - Production Environment Variables
# ==========================================

# Pollinations AI Real Image Generation Engine
# Server-side only: NEVER prefix with NEXT_PUBLIC_ or expose to client code.
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=tongyi-mai/z-image-turbo
POLLINATIONS_IMAGE_SIZE=1024x1024
POLLINATIONS_IMAGE_WIDTH=1024
POLLINATIONS_IMAGE_HEIGHT=1024

# Google Gemini Image Generation Engine (Optional fallback)
# Server-side only: NEVER prefix with NEXT_PUBLIC_ or expose to client code.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_IMAGE_SIZE=1K

# Application Metadata
NEXT_PUBLIC_APP_NAME=GIMA AI STUDIO
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_URL=
