# ==========================================
# GIMA AI Studio - Environment Configuration
# ==========================================

# Current Phase: Demo & Deterministic Preview Mode
# Image generation engine is currently in architectural preparation mode.
# Future Phase 2 image providers can be configured below.

# Application
NEXT_PUBLIC_APP_NAME="GIMA AI STUDIO"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Future Image Generation Providers (Uncomment in Phase 2)
# IMAGE_PROVIDER="gemini" # options: "gemini" | "openai" | "local" | "custom"
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# LOCAL_MODEL_ENDPOINT=""

# Optional Custom Vector Store (Defaults to high-speed local indexing)
# KNOWLEDGE_STORAGE_PROVIDER="local"
