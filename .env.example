# ==========================================
# GIMA AI Studio - Environment Configuration
# ==========================================

# Google Gemini Image Generation Engine (Phase 2)
# Server-side only: NEVER prefix with NEXT_PUBLIC_ or expose to client code.
GEMINI_API_KEY=""

# Configurable Image Generation Model:
# Default (High-Efficiency Workhorse): gemini-nano-banana-2.1
# Premium Model: gemini-3-pro-image
GEMINI_IMAGE_MODEL="gemini-nano-banana-2.1"

# Configurable Resolution: 1K (default), 2K, 4K
GEMINI_IMAGE_SIZE="1K"

# Application Metadata
NEXT_PUBLIC_APP_NAME="GIMA AI STUDIO"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
